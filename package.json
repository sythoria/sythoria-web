{
  "name": "sythoria-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run lint:check && npm run format:check && npm run typecheck && npm run content:check && next build",
    "start": "next start",
    "lint": "eslint",
    "lint:check": "eslint src/ tests/ playwright.config.ts",
    "lint:fix": "eslint src/ tests/ playwright.config.ts --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json,mdx}\" \"tests/**/*.{ts,tsx}\" \"scripts/**/*.{mjs,json}\" \"*.{json,mjs,ts}\" \"README.md\" \".github/**/*.{yml,yaml}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json,mdx}\" \"tests/**/*.{ts,tsx}\" \"scripts/**/*.{mjs,json}\" \"*.{json,mjs,ts}\" \"README.md\" \".github/**/*.{yml,yaml}\"",
    "typecheck": "tsc --noEmit",
    "content:check": "node scripts/validate-content.mjs && node scripts/validate-desktop-facts.mjs",
    "assets:optimize": "node scripts/optimize-assets.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "check": "npm run lint:check && npm run format:check && npm run typecheck && npm run content:check && npm run test && next build"
  },
  "dependencies": {
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.16.0",
    "next": "16.2.12",
    "next-mdx-remote": "^6.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-pretty-code": "^0.14.5",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.4.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "sharp": "^0.35.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.7"
  },
  "overrides": {
    "postcss": "^8.5.25",
    "sharp": "^0.35.3",
    "js-yaml": "^4.3.1",
    "brace-expansion@<2.0.0": "^1.1.18",
    "brace-expansion@>=3.0.0 <6.0.0": "^5.0.9"
  },
  "allowScripts": {
    "sharp@0.35.3": true,
    "unrs-resolver@1.12.2": true
  }
}
